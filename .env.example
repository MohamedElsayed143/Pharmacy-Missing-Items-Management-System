# Pharmacy Missing Items Management System - Environment Configuration
PORT=4000
NODE_ENV=development
JWT_SECRET=pharmacy-missing-items-jwt-secret-key-production-change-me

# PostgreSQL Connection String
DATABASE_URL="postgresql://postgres@127.0.0.1:5433/pharmacy_db?schema=public"

# Workstation Network Configuration
CORS_ORIGIN=*

# ==========================================
# Meta WhatsApp Business Cloud API Settings
# ==========================================
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_WEBHOOK_VERIFY_TOKEN=pharmacy_whatsapp_verify_token_default
WHATSAPP_APP_SECRET=
